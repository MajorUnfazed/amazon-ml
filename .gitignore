dataset/
data/
student_resource/
__MACOSX/

# Environments
.venv/
env/
venv/
ENV/

# Secrets and keys
*.pem
*.key
*.env

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Submissions and large outputs
*.zip
output/*.tsv

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
